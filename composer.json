{
    "name": "angus/laminas-mvc-console",
    "description": "Integration between laminas-mvc and laminas-console",
    "license": "BSD-3-Clause",
    "keywords": [
        "laminas",
        "mvc",
        "console"
    ],
    "homepage": "https://laminas.dev",
    "support": {
        "docs": "https://docs.laminas.dev/laminas-mvc-console/",
        "issues": "https://github.com/laminas/laminas-mvc-console/issues",
        "source": "https://github.com/laminas/laminas-mvc-console",
        "rss": "https://github.com/laminas/laminas-mvc-console/releases.atom",
        "chat": "https://laminas.dev/chat",
        "forum": "https://discourse.laminas.dev"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laminas": {
            "component": "Laminas\\Mvc\\Console"
        }
    },
    "require": {
        "php": "^8.2",
        "angus/laminas-console": "1.0.4",
        "container-interop/container-interop": ">=1.2.0",
        "laminas/laminas-eventmanager": ">=3.15.0",
        "laminas/laminas-modulemanager": ">=2.19.0",
        "laminas/laminas-mvc": ">=3.8.0",
        "laminas/laminas-router": ">=3.19.0",
        "laminas/laminas-servicemanager": ">=3.24.0",
        "laminas/laminas-stdlib": ">=3.21.0",
        "laminas/laminas-text": ">=2.13.0",
        "laminas/laminas-view": ">=2.44.0",
        "laminas/laminas-zendframework-bridge": ">=1.8.0"
    },
    "require-dev": {
        "laminas/laminas-coding-standard": "~3.1.0",
        "laminas/laminas-filter": ">=2.42.0",
        "phpspec/prophecy": ">=1.26.1",
        "phpspec/prophecy-phpunit": ">=2.5.0",
        "phpunit/phpunit": ">=11.5.57"
    },
    "conflict": {
        "laminas/laminas-mvc": "<3.0.0"
    },
    "suggest": {
        "laminas/laminas-filter": "^2.6.1, to filter rendered results"
    },
    "autoload": {
        "psr-4": {
            "Laminas\\Mvc\\Console\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaminasTest\\Mvc\\Console\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml"
    },
    "replace": {
        "zendframework/zend-mvc-console": "^1.2.0"
    }
}
